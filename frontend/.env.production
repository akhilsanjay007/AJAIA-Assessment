# Backend origin only. Include https://, with no path and no trailing slash.
# Example: https://your-service.up.railway.app
# A Railway variable of the same name overrides this at build time.
# Leave VITE_API_URL unset for local `npm run dev`; the Vite dev server proxies `/api`.
VITE_API_URL=https://YOUR-RAILWAY-BACKEND-URL
